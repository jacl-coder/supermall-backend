		{
			"name": "更新收货地址",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const addressId = pm.environment.get('addressId');",
							"",
							"if (!addressId) {",
							"    console.error('Missing address ID');",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"const updatedPhone = '139' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0');",
							"const updatedName = '更新用户' + new Date().getTime().toString().slice(-4);",
							"",
							"pm.environment.set('updatedPhone', updatedPhone);",
							"pm.environment.set('updatedName', updatedName);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('更新收货地址响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.id).to.equal(Number(pm.environment.get('addressId')));",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
