	"item": [
		{
			"name": "用户登录",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('登录响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.token).to.be.a('string');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"    pm.expect(jsonData.data.username).to.be.a('string');",
							"});",
							"",
							"if (jsonData.success && jsonData.data) {",
							"    pm.environment.set('token', jsonData.data.token);",
							"    pm.environment.set('userId', jsonData.data.id);",
							"    pm.environment.set('username', jsonData.data.username);",
							"",
							"    console.log('Auth info saved:', {",
							"        userId: jsonData.data.id,",
							"        username: jsonData.data.username",
							"    });",
							"}",
							"",
							"const savedToken = pm.environment.get('token');",
							"console.log('Saved token:', savedToken ? savedToken.substring(0, 20) + '...' : 'null');"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{loginUsername}}\",\n    \"password\": \"Test123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "用户登录接口"
			},
			"response": []
		},
		{
			"name": "创建用户资料",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const token = pm.environment.get('token');",
							"const userId = pm.environment.get('userId');",
							"const username = pm.environment.get('username');",
							"",
							"if (!token || !userId || !username) {",
							"    console.error('Missing auth info. Please run login test first.');",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"const testFullName = '测试用户' + new Date().getTime().toString().slice(-4);",
							"const testPhoneNumber = '138' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0');",
							"",
							"pm.environment.set('testFullName', testFullName);",
							"pm.environment.set('testPhoneNumber', testPhoneNumber);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('创建用户资料响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"",
							"    if (jsonData.data.id) {",
							"        pm.environment.set('profileId', jsonData.data.id);",
							"    }",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"fullName\": \"{{testFullName}}\",\n    \"phoneNumber\": \"{{testPhoneNumber}}\",\n    \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users/profile",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"profile"
					]
				},
				"description": "创建用户资料"
			},
			"response": []
		},
		{
			"name": "创建收货地址",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const token = pm.environment.get('token');",
							"",
							"if (!token) {",
							"    console.error('Missing token');",
							"    postman.setNextRequest(null);",
							"    return;",
							"}",
							"",
							"const testPhone = '138' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0');",
							"const testName = '测试用户' + new Date().getTime().toString().slice(-4);",
							"",
							"pm.environment.set('testPhone', testPhone);",
							"pm.environment.set('testName', testName);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('创建收货地址响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"",
							"    if (jsonData.data.id) {",
							"        pm.environment.set('addressId', jsonData.data.id);",
							"    }",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"receiverName\": \"{{testName}}\",\n    \"receiverPhone\": \"{{testPhone}}\",\n    \"province\": \"广东省\",\n    \"city\": \"深圳市\",\n    \"district\": \"南山区\",\n    \"street\": \"科技园路1号\",\n    \"postalCode\": \"518000\",\n    \"isDefault\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users/addresses",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
