    {
      "name": "Order",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 确保已经添加了商品到购物车",
                  "if (!pm.environment.get('cart_item_id')) {",
                  "    console.error('请先添加商品到购物车并设置cart_item_id环境变量');",
                  "    postman.setNextRequest(null);",
                  "}",
                  "// 确保已经添加了收货地址",
                  "if (!pm.environment.get('address_id')) {",
                  "    console.error('请先添加收货地址并设置address_id环境变量');",
                  "    postman.setNextRequest(null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.environment.set('order_id', jsonData.data.id);",
                  "    pm.environment.set('order_no', jsonData.data.orderNo);",
                  "    console.log('订单创建成功，ID:', jsonData.data.id);",
                  "} else {",
                  "    console.error('订单创建失败:', jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"addressId\": {{address_id}},\n    \"cartItemIds\": [{{cart_item_id}}]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            },
            "description": "创建订单（需要先添加商品到购物车，并添加收货地址）"
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "{{order_id}}"]
            },
            "description": "获取订单详情"
          }
        },
        {
          "name": "Get Order List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders?status=pending_payment&page=1&size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "pending_payment",
                  "description": "订单状态：pending_payment(待付款), paid(已付款), shipped(已发货), completed(已完成), canceled(已取消)"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "获取订单列表"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "{{order_id}}", "cancel"]
            },
            "description": "取消订单（仅待付款状态可取消）"
          }
        },
        {
          "name": "Confirm Order Received",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "{{order_id}}", "confirm"]
            },
            "description": "确认收货（仅已发货状态可确认收货）"
          }
        }
      ]
    },
