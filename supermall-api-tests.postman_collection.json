                "exec": [
                  "const timestamp = new Date().getTime();",
                  "const randomUsername = 'user' + Math.floor(Math.random() * 10000);",
                  "pm.environment.set('test_username', randomUsername);",
                  "pm.environment.set('test_password', 'password123');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"email\": \"{{test_username}}@example.com\",\n    \"password\": \"{{test_password}}\",\n    \"fullName\": \"Test User\",\n    \"phoneNumber\": \"13800138000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
