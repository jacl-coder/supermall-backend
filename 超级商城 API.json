				{
					"name": "用户登录",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// 测试响应状态码\r",
									"pm.test(\"状态码是 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"// 测试响应格式\r",
									"pm.test(\"响应格式正确\", function () {\r",
									"    pm.response.to.be.json;\r",
									"});\r",
									"\r",
									"// 测试业务状态码\r",
									"pm.test(\"业务状态码是 200\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.code).to.equal(200);\r",
									"});\r",
									"\r",
									"// 测试是否包含 token\r",
									"pm.test(\"响应包含 token\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.data.token).to.exist;\r",
									"});\r",
									"\r",
									"// 如果登录成功，保存 token 到环境变量\r",
									"if (pm.response.code === 200) {\r",
									"    var jsonData = pm.response.json();\r",
									"    if (jsonData.code === 200 && jsonData.data && jsonData.data.token) {\r",
									"        pm.environment.set(\"token\", \"Bearer \" + jsonData.data.token);\r",
									"        console.log(\"Token 已保存到环境变量\");\r",
									"    }\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
