	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 全局预请求脚本",
					"const token = pm.environment.get('token');",
					"const userId = pm.environment.get('userId');",
					"const username = pm.environment.get('username');",
					"",
					"// 检查认证信息",
					"if (!token || !userId || !username) {",
					"    if (!pm.request.url.path.includes('login')) {",
					"        console.warn('Missing authentication info. Please run login test first.');",
					"        console.log('Current state:', {",
					"            token: token ? '***' : null,",
					"            userId: userId || null,",
					"            username: username || null",
					"        });",
					"    }",
					"}",
					"",
					"console.log('=== Request Info ===');",
					"console.log('Request URL:', pm.request.url.toString());",
					"console.log('Request Method:', pm.request.method);",
					"console.log('Current token:', token ? token.substring(0, 20) + '...' : 'null');",
					"console.log('Current user:', username ? `${username} (${userId})` : 'not logged in');",
					"console.log('==================');"
				]
			}
		}
	],
