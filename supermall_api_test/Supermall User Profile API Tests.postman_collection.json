	"item": [
		{
			"name": "用户登录",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('登录响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.token).to.be.a('string');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"    pm.expect(jsonData.data.username).to.be.a('string');",
							"});",
							"",
							"if (jsonData.success && jsonData.data) {",
							"    // 保存认证信息",
							"    pm.environment.set('token', jsonData.data.token);",
							"    pm.environment.set('userId', jsonData.data.id);",
							"    pm.environment.set('username', jsonData.data.username);",
							"    pm.environment.set('userEmail', jsonData.data.email);",
							"    pm.environment.set('userRole', jsonData.data.role);",
							"",
							"    console.log('Auth info saved:', {",
							"        userId: jsonData.data.id,",
							"        username: jsonData.data.username,",
							"        email: jsonData.data.email,",
							"        role: jsonData.data.role",
							"    });",
							"}",
							"",
							"// 验证token是否正确保存",
							"const savedToken = pm.environment.get('token');",
							"console.log('Saved token:', savedToken ? savedToken.substring(0, 20) + '...' : 'null');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"testuser4092350\",\n    \"password\": \"Test123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "创建用户资料",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// 检查认证信息",
							"const token = pm.environment.get('token');",
							"const userId = pm.environment.get('userId');",
							"const username = pm.environment.get('username');",
							"",
							"if (!token || !userId || !username) {",
							"    console.error('Missing auth info. Please run login test first.');",
							"    console.log('Current state:', {",
							"        token: token ? '***' : null,",
							"        userId: userId || null,",
							"        username: username || null",
							"    });",
							"    postman.setNextRequest(null);",
							"} else {",
							"    console.log('Using auth info:', {",
							"        token: token.substring(0, 20) + '...',",
							"        userId: userId,",
							"        username: username",
							"    });",
							"}",
							"",
							"// 生成测试数据",
							"const testFullName = '测试用户' + new Date().getTime().toString().slice(-4);",
							"const testPhoneNumber = '138' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0');",
							"",
							"pm.environment.set('testFullName', testFullName);",
							"pm.environment.set('testPhoneNumber', testPhoneNumber);",
							"",
							"console.log('Generated test data:', {",
							"    fullName: testFullName,",
							"    phoneNumber: testPhoneNumber",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"console.log('Response:', jsonData);",
							"",
							"pm.test('创建用户资料响应格式正确', function() {",
							"    if (!jsonData.success) {",
							"        console.error('Error response:', jsonData);",
							"        pm.expect.fail('Request failed: ' + jsonData.message);",
							"    }",
							"",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"    pm.expect(jsonData.data.fullName).to.equal(pm.environment.get('testFullName'));",
							"    pm.expect(jsonData.data.phoneNumber).to.equal(pm.environment.get('testPhoneNumber'));",
							"    pm.expect(jsonData.data.createdAt).to.be.a('string');",
							"    pm.expect(jsonData.data.updatedAt).to.be.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"fullName\": \"{{testFullName}}\",\n    \"phoneNumber\": \"{{testPhoneNumber}}\",\n    \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
				},
