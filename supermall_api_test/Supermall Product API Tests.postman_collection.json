						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"console.log('=== Response Check ===');",
							"console.log('Response status:', pm.response.status);",
							"console.log('Response body:', JSON.stringify(jsonData, null, 2));",
							"",
							"pm.test('获取商品列表响应格式正确', function() {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.records).to.be.an('array');",
							"    pm.expect(jsonData.data.total).to.be.a('number');",
							"    pm.expect(jsonData.data.size).to.be.a('number');",
							"    pm.expect(jsonData.data.current).to.be.a('number');",
							"",
							"    // 如果有商品，验证第一个商品的格式",
							"    if (jsonData.data.records.length > 0) {",
							"        const firstProduct = jsonData.data.records[0];",
							"        pm.expect(firstProduct.id).to.be.a('number');",
							"        pm.expect(firstProduct.name).to.be.a('string');",
							"        pm.expect(firstProduct.description).to.be.a('string');",
							"        pm.expect(firstProduct.price).to.be.a('number');",
							"        pm.expect(firstProduct.originalPrice).to.be.a('number');",
							"        pm.expect(firstProduct.stock).to.be.a('number');",
							"        pm.expect(firstProduct.mainImage).to.be.a('string');",
							"        pm.expect(firstProduct.status).to.be.a('string');",
							"        pm.expect(firstProduct.merchantId).to.equal(Number(pm.environment.get('merchantId')));",
							"",
