		{
			"name": "获取商品详情",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 从Local环境获取变量",
							"const productId = pm.environment.get('productId');",
							"const merchantToken = pm.environment.get('merchantToken');",
							"",
							"console.log('=== Pre-request Check ===');",
							"console.log('Environment:', pm.environment.name);",
							"console.log('Product ID:', productId);",
							"console.log('Merchant Token:', merchantToken ? merchantToken.substring(0, 20) + '...' : 'null');",
							"",
							"if (!productId) {",
							"    console.error('Missing product ID in Local environment - Please run create product test first');",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"if (!merchantToken) {",
							"    console.error('Missing merchant token in Local environment - Please run merchant login test first');",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"// 手动构建请求URL",
							"const baseUrl = pm.environment.get('baseUrl');",
							"const requestUrl = baseUrl + '/api/products/' + productId;",
							"pm.environment.set('currentRequestUrl', requestUrl);",
							"",
							"console.log('Base URL:', baseUrl);",
							"console.log('Request URL:', requestUrl);",
							"console.log('=====================');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"console.log('=== Response Check ===');",
							"console.log('Response status:', pm.response.status);",
							"console.log('Response body:', JSON.stringify(jsonData, null, 2));",
							"",
							"pm.test('获取商品详情响应格式正确', function() {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    ",
							"    const expectedProductId = Number(pm.environment.get('productId'));",
							"    console.log('Expected product ID:', expectedProductId);",
							"    console.log('Actual product ID:', jsonData.data.id);",
							"    ",
							"    pm.expect(jsonData.data.id).to.equal(expectedProductId);",
							"    pm.expect(jsonData.data.name).to.be.a('string');",
							"    pm.expect(jsonData.data.description).to.be.a('string');",
							"    pm.expect(jsonData.data.price).to.be.a('number');",
							"    pm.expect(jsonData.data.originalPrice).to.be.a('number');",
							"    pm.expect(jsonData.data.stock).to.be.a('number');",
							"    pm.expect(jsonData.data.mainImage).to.be.a('string');",
							"    pm.expect(jsonData.data.status).to.be.a('string');",
							"    pm.expect(jsonData.data.merchantId).to.equal(Number(pm.environment.get('merchantId')));",
							"});",
							"",
							"console.log('=====================');"
						]
					}
				}
			],
