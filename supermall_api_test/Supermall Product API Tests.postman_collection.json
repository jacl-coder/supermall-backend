	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 检查必要的环境变量",
					"const requiredVars = ['baseUrl', 'merchantToken', 'merchantId'];",
					"const missingVars = requiredVars.filter(varName => !pm.environment.get(varName));",
					"",
					"if (missingVars.length > 0) {",
					"    console.warn('Missing environment variables:', missingVars.join(', '));",
					"}",
					"",
					"console.log('=== Request Info ===');",
					"console.log('Request URL:', pm.request.url.toString());",
					"console.log('Request Method:', pm.request.method);",
					"console.log('Current merchant token:', pm.environment.get('merchantToken') ? pm.environment.get('merchantToken').substring(0, 20) + '...' : 'null');",
					"console.log('Current merchant ID:', pm.environment.get('merchantId') || 'null');",
					"console.log('==================');"
				]
			}
		}
	]
