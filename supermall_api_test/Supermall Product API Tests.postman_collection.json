		{
			"name": "商家登录",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 设置默认的商家用户名（如果没有注册过的话）",
							"const defaultMerchantUsername = 'merchant5994685';",
							"const savedMerchantUsername = pm.environment.get('lastRegisteredMerchantUsername');",
							"",
							"if (savedMerchantUsername) {",
							"    pm.environment.set('loginMerchantUsername', savedMerchantUsername);",
							"    console.log('Using saved merchant username for login:', savedMerchantUsername);",
							"} else {",
							"    pm.environment.set('loginMerchantUsername', defaultMerchantUsername);",
							"    console.log('Using default merchant username:', defaultMerchantUsername);",
							"}"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"// 打印完整的响应内容",
							"console.log('Login Response:', JSON.stringify(jsonData, null, 2));",
							"",
							"pm.test('商家登录响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.token).to.be.a('string');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"    pm.expect(jsonData.data.username).to.be.a('string');",
							"    pm.expect(jsonData.data.role).to.be.a('string');",
							"});",
							"",
							"if (jsonData.success && jsonData.data) {",
							"    // 从auth_users表获取用户ID",
							"    const authId = jsonData.data.id;",
							"",
							"    // 保存认证信息",
							"    pm.environment.set('merchantToken', jsonData.data.token);",
							"    pm.environment.set('authId', authId);",
							"",
							"    // 发送请求获取商家信息",
							"    pm.sendRequest({",
							"        url: pm.environment.get('baseUrl') + '/api/merchants/profile',",
							"        method: 'GET',",
							"        header: {",
							"            'Authorization': 'Bearer ' + jsonData.data.token",
							"        }",
							"    }, function (err, res) {",
							"        if (err) {",
							"            console.error('Failed to get merchant profile:', err);",
							"            throw new Error('Failed to get merchant profile');",
							"        }",
							"",
							"        const profileData = res.json();",
							"        console.log('Merchant Profile:', profileData);",
							"",
							"        if (profileData.success && profileData.data) {",
							"            pm.environment.set('merchantId', profileData.data.id);",
							"            console.log('Merchant login successful. Info:', {",
							"                authId: authId,",
							"                merchantId: profileData.data.id,",
							"                username: jsonData.data.username,",
							"                role: jsonData.data.role",
							"            });",
							"        } else {",
							"            console.error('Failed to get merchant profile:', profileData.message);",
							"            throw new Error('Failed to get merchant profile: ' + profileData.message);",
							"        }",
							"    });",
							"} else {",
							"    console.error('Login failed:', jsonData.message);",
							"    throw new Error('Login failed: ' + jsonData.message);",
							"}",
							"",
							"// 验证所有必需的环境变量",
							"const requiredVars = ['merchantToken', 'authId'];",
							"const missingVars = requiredVars.filter(varName => !pm.environment.get(varName));",
							"",
							"if (missingVars.length > 0) {",
							"    console.error('Missing required environment variables:', missingVars);",
							"    throw new Error('Missing required environment variables: ' + missingVars.join(', '));",
							"}",
							"",
							"// 输出环境变量状态",
							"console.log('Environment variables after login:', {",
							"    merchantToken: pm.environment.get('merchantToken') ? '***' : null,",
							"    authId: pm.environment.get('authId'),",
							"    merchantId: pm.environment.get('merchantId')",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{loginMerchantUsername}}\",\n    \"password\": \"Test123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "商家登录接口"
			},
			"response": []
		},
		{
			"name": "创建商品",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 检查商家认证信息",
							"const merchantToken = pm.environment.get('merchantToken');",
							"const merchantId = pm.environment.get('merchantId');",
							"const merchantRoleId = pm.environment.get('merchantRoleId');",
							"",
							"if (!merchantToken || !merchantId || merchantRoleId !== 3) {",
							"    console.error('Missing merchant authentication info or invalid role');",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"console.log('Current merchant token:', merchantToken ? merchantToken.substring(0, 20) + '...' : 'null');",
							"console.log('Current merchant ID:', merchantId);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('创建商品响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.id).to.be.a('number');",
							"    pm.expect(jsonData.data.name).to.be.a('string');",
							"    pm.expect(jsonData.data.description).to.be.a('string');",
							"    pm.expect(jsonData.data.price).to.be.a('number');",
							"    pm.expect(jsonData.data.originalPrice).to.be.a('number');",
							"    pm.expect(jsonData.data.stock).to.be.a('number');",
							"    pm.expect(jsonData.data.mainImage).to.be.a('string');",
							"    pm.expect(jsonData.data.status).to.be.a('string');",
							"    pm.expect(jsonData.data.merchantId).to.equal(Number(pm.environment.get('merchantId')));",
							"});",
							"",
							"// 保存商品ID到环境变量",
							"if (jsonData.success && jsonData.data && jsonData.data.id) {",
							"    pm.environment.set('productId', jsonData.data.id);",
							"    console.log('Saved product ID:', jsonData.data.id);",
							"}",
							"",
							"// 验证环境变量是否正确设置",
							"const savedProductId = pm.environment.get('productId');",
							"console.log('Verified saved product ID:', savedProductId);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{merchantToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"测试商品\",\n    \"description\": \"这是一个测试商品\",\n    \"categoryId\": 1,\n    \"price\": 99.99,\n    \"originalPrice\": 199.99,\n    \"stock\": 100,\n    \"mainImage\": \"https://example.com/image.jpg\",\n    \"status\": \"ON_SALE\"\n}"
