				{
					"name": "获取商家列表",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"",
									"pm.test('获取商家列表响应格式正确', function() {",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.be.an('object');",
									"    pm.expect(jsonData.data.records).to.be.an('array');",
									"    ",
									"    if (jsonData.data.records.length > 0) {",
									"        const firstMerchant = jsonData.data.records[0];",
									"        pm.environment.set('merchantId', firstMerchant.id);",
									"        console.log('First merchant ID saved:', firstMerchant.id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/merchants?page=1&size=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"merchants"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
