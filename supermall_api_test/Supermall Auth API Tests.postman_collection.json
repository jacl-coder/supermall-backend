		{
			"name": "商家注册-步骤1：用户注册",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('商家用户注册响应格式正确', function() {",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.data).to.be.an('object');",
							"    pm.expect(jsonData.data.token).to.be.a('string');",
							"    pm.expect(jsonData.data.username).to.equal(pm.variables.get('testMerchantUsername'));",
							"});",
							"",
							"if (jsonData.success && jsonData.data && jsonData.data.token) {",
							"    pm.environment.set('merchantToken', jsonData.data.token);",
							"    pm.environment.set('lastRegisteredMerchantUsername', jsonData.data.username);",
							"    console.log('Merchant user registration successful. Username:', jsonData.data.username);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// 生成测试商家用户名",
							"const timestamp = new Date().getTime().toString().slice(-4);",
							"const randomNum = Math.floor(Math.random() * 1000).toString().padStart(3, '0');",
							"const testMerchantUsername = `merchant${timestamp}${randomNum}`;",
							"const testMerchantEmail = `${testMerchantUsername}@example.com`;",
							"",
							"pm.environment.set('testMerchantUsername', testMerchantUsername);",
							"pm.environment.set('testMerchantEmail', testMerchantEmail);",
							"console.log('Generated test merchant:', testMerchantUsername);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{testMerchantUsername}}\",\n    \"email\": \"{{testMerchantEmail}}\",\n    \"password\": \"Test123456\",\n    \"fullName\": \"测试商家\",\n    \"phoneNumber\": \"13800138000\",\n    \"userType\": \"MERCHANT\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
