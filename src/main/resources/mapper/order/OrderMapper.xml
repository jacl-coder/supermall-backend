<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermall.backend.domain.order.mapper.OrderMapper">
    
    <resultMap id="OrderVOMap" type="com.supermall.backend.domain.order.vo.OrderVO">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="freightAmount" column="freight_amount"/>
        <result property="status" column="status"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="deliveryTime" column="delivery_time"/>
        <result property="receiveTime" column="receive_time"/>
        <result property="commentTime" column="comment_time"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverAddress" column="receiver_address"/>
        <result property="note" column="note"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
        <collection property="orderItems" ofType="com.supermall.backend.domain.order.entity.OrderItem">
            <id property="id" column="item_id"/>
            <result property="orderId" column="order_id"/>
            <result property="orderNo" column="item_order_no"/>
            <result property="productId" column="product_id"/>
            <result property="productName" column="product_name"/>
            <result property="productImage" column="product_image"/>
            <result property="price" column="price"/>
            <result property="quantity" column="quantity"/>
            <result property="totalAmount" column="item_total_amount"/>
        </collection>
    </resultMap>
    
    <select id="getOrderById" resultMap="OrderVOMap">
        SELECT 
            o.*,
            i.id as item_id,
            i.order_no as item_order_no,
            i.product_id,
            i.product_name,
            i.product_image,
            i.price,
            i.quantity,
            i.total_amount as item_total_amount
        FROM `order` o
        LEFT JOIN order_item i ON o.id = i.order_id
        WHERE o.id = #{id} 
            AND o.deleted = 0
    </select>
    
    <select id="listOrders" resultMap="OrderVOMap">
        SELECT 
            o.*,
            i.id as item_id,
            i.order_no as item_order_no,
            i.product_id,
            i.product_name,
            i.product_image,
            i.price,
            i.quantity,
            i.total_amount as item_total_amount
        FROM `order` o
        LEFT JOIN order_item i ON o.id = i.order_id
        WHERE o.deleted = 0
        ORDER BY o.created_time DESC
    </select>
</mapper> 