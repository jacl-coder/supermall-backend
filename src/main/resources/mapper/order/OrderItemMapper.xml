<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermall.backend.domain.order.mapper.OrderItemMapper">
    <select id="listByOrderId" resultType="com.supermall.backend.domain.order.entity.OrderItem">
        SELECT *
        FROM order_item
        WHERE order_id = #{orderId}
            AND deleted = 0
    </select>
</mapper> 