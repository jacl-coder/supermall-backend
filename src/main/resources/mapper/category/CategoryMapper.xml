<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermall.backend.domain.category.mapper.CategoryMapper">
    
    <resultMap id="CategoryVOMap" type="com.supermall.backend.domain.category.vo.CategoryVO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="level" column="level"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="parentName" column="parent_name"/>
    </resultMap>
    
    <select id="listCategories" resultMap="CategoryVOMap">
        SELECT 
            c.*,
            p.name as parent_name
        FROM category c
        LEFT JOIN category p ON c.parent_id = p.id 
            AND p.deleted = 0
        WHERE c.deleted = 0
        ORDER BY c.sort ASC
    </select>
    
    <select id="getCategoryById" resultMap="CategoryVOMap">
        SELECT 
            c.*,
            p.name as parent_name
        FROM category c
        LEFT JOIN category p ON c.parent_id = p.id 
            AND p.deleted = 0
        WHERE c.id = #{id} 
            AND c.deleted = 0
    </select>
    
    <select id="listChildren" resultType="com.supermall.backend.domain.category.entity.Category">
        SELECT *
        FROM category
        WHERE parent_id = #{parentId}
            AND deleted = 0
        ORDER BY sort ASC
    </select>
</mapper> 