{
    "info": {
        "name": "用户认证",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "用户注册",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\",\n    \"nickname\": \"管理员2\",\n    \"phone\": \"13800138002\",\n    \"email\": \"admin2@example.com\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/register",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "register"]
                }
            },
            "response": []
        },
        {
            "name": "用户登录",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "// 测试响应状态码",
                            "pm.test(\"状态码是 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "// 测试响应格式",
                            "pm.test(\"响应格式正确\", function () {",
                            "    pm.response.to.be.json;",
                            "});",
                            "",
                            "// 测试业务状态码",
                            "pm.test(\"业务状态码是 200\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.code).to.equal(200);",
                            "});",
                            "",
                            "// 测试是否包含 token",
                            "pm.test(\"响应包含 token\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.token).to.exist;",
                            "});",
                            "",
                            "// 如果登录成功，保存 token 到环境变量",
                            "if (pm.response.code === 200) {",
                            "    var jsonData = pm.response.json();",
                            "    if (jsonData.code === 200 && jsonData.data && jsonData.data.token) {",
                            "        pm.environment.set(\"token\", \"Bearer \" + jsonData.data.token);",
                            "        console.log(\"Token 已保存到环境变量\");",
                            "    }",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "auth", "login"]
                }
            },
            "response": []
        }
    ]
} 