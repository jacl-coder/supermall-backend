{
    "info": {
        "name": "SuperMall API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "认证管理",
            "item": [
                {
                    "name": "用户注册",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"test\",\n    \"password\": \"123456\",\n    \"email\": \"test@example.com\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8081/api/auth/register",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8081",
                            "path": ["api", "auth", "register"]
                        }
                    }
                },
                {
                    "name": "用户登录",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"test\",\n    \"password\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8081/api/auth/login",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8081",
                            "path": ["api", "auth", "login"]
                        }
                    }
                }
            ]
        },
        {
            "name": "分类管理",
            "item": [
                {
                    "name": "获取分类树",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:8081/api/categories/tree",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8081",
                            "path": ["api", "categories", "tree"]
                        }
                    }
                },
                {
                    "name": "创建分类",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"测试分类\",\n    \"parentId\": 0,\n    \"sort\": 0,\n    \"icon\": \"test-icon\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8081/api/categories",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8081",
                            "path": ["api", "categories"]
                        }
                    }
                }
            ]
        }
    ]
} 