{
    "info": {
        "_postman_id": "product-collection-id",
        "name": "商品管理",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "创建商品",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"iPhone 15\",\n    \"description\": \"Apple iPhone 15 新品上市\",\n    \"categoryId\": 1,\n    \"brandId\": 1,\n    \"price\": 6999.00,\n    \"stock\": 1000,\n    \"mainImage\": \"iphone15.jpg\",\n    \"subImages\": [\"iphone15-1.jpg\", \"iphone15-2.jpg\"],\n    \"status\": 1\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/products",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products"]
                }
            },
            "response": []
        },
        {
            "name": "获取商品列表",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/products?categoryId=1&brandId=1&keyword=iPhone&pageNum=1&pageSize=10",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products"],
                    "query": [
                        {
                            "key": "categoryId",
                            "value": "1",
                            "description": "分类ID"
                        },
                        {
                            "key": "brandId",
                            "value": "1",
                            "description": "品牌ID"
                        },
                        {
                            "key": "keyword",
                            "value": "iPhone",
                            "description": "搜索关键词"
                        },
                        {
                            "key": "pageNum",
                            "value": "1"
                        },
                        {
                            "key": "pageSize",
                            "value": "10"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "获取商品详情",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/products/1",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1"]
                }
            },
            "response": []
        },
        {
            "name": "更新商品",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"iPhone 15 Pro\",\n    \"description\": \"Apple iPhone 15 Pro 新品上市\",\n    \"price\": 8999.00,\n    \"stock\": 500,\n    \"status\": 1\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/products/1",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1"]
                }
            },
            "response": []
        },
        {
            "name": "删除商品",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/products/1",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1"]
                }
            },
            "response": []
        },
        {
            "name": "更新商品状态",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/products/1/status?status=1",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1", "status"],
                    "query": [
                        {
                            "key": "status",
                            "value": "1",
                            "description": "商品状态：0-下架，1-上架"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "上传商品主图",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": "/path/to/product.jpg"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/api/products/1/main-image",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1", "main-image"]
                }
            },
            "response": []
        },
        {
            "name": "上传商品子图",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "files",
                            "type": "file",
                            "src": ["/path/to/product1.jpg", "/path/to/product2.jpg"]
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/api/products/1/sub-images",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "products", "1", "sub-images"]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        }
    ]
} 