{
    "info": {
        "name": "分类管理",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "创建根分类",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"电子产品\",\n    \"parentId\": 0,\n    \"sort\": 1,\n    \"icon\": \"electronics.png\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/categories",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "categories"]
                }
            },
            "response": []
        },
        {
            "name": "创建子分类",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"手机\",\n    \"parentId\": 1,\n    \"sort\": 1,\n    \"icon\": \"phone.png\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/categories",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "categories"]
                }
            },
            "response": []
        },
        {
            "name": "获取分类树",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/categories/tree",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "categories", "tree"]
                }
            },
            "response": []
        }
    ]
} 